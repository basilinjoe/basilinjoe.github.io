{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!.next",
			"!out",
			"!build",
			"!next-env.d.ts",
			"!app/globals.css"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noAmbiguousAnchorText": "warn",
				"noNoninteractiveElementInteractions": "warn",
				"noNoninteractiveTabindex": "error",
				"useAnchorContent": "error",
				"useFocusableInteractive": "error",
				"useHeadingContent": "error",
				"useValidAnchor": "error",
				"useButtonType": "error",
				"noSvgWithoutTitle": "error",
				"noLabelWithoutControl": "error"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"useHookAtTopLevel": "error",
				"useJsxKeyInIterable": "error",
				"noUnusedImports": "warn",
				"noUnusedVariables": "warn",
				"noBeforeInteractiveScriptOutsideDocument": "error",
				"noNextAsyncClientComponent": "error",
				"useInlineScriptId": "error"
			},
			"performance": {
				"noImgElement": "warn",
				"noSyncScripts": "error",
				"noUnwantedPolyfillio": "error",
				"useGoogleFontPreconnect": "warn"
			},
			"style": {
				"noHeadElement": "error",
				"useImportType": "off"
			},
			"suspicious": {
				"noDocumentImportInPage": "error",
				"noHeadImportInDocument": "error",
				"useGoogleFontDisplay": "warn",
				"noDuplicateFontNames": "error",
				"noDuplicateJsxProps": "error",
				"noArrayIndexKey": "warn",
				"noExplicitAny": "warn",
				"noUnknownAtRules": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off",
				"noScriptUrl": "error"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "off" } }
	}
}
